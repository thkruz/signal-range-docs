{
	// Cloudflare Workers configuration for signal-range
	// Astro SSR with Cloudflare adapter
	"name": "signal-range-docs",
	"main": "dist/_worker.js/index.js",
	// Compatibility date - using a recent date for latest features
	"compatibility_date": "2025-11-01",
	// Enable Node.js compatibility layer
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Static assets configuration
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "none",
		"not_found_handling": "none"
	},
	"observability": {
		"enabled": true
	},
	// Map to your custom domain
	"routes": [
		"docs.signalrange.space/*"
	]
}