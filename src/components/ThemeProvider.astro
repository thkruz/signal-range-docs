---
import Default from '@astrojs/starlight/components/ThemeProvider.astro';

// The docs are dark-only: every request is forced to the dark theme and the
// ?dark= parameter (sent by the app's brief iframes) is accepted but no longer
// changes anything. The theme picker is removed (ThemeSelect.astro).
---

{/* Always dark: override localStorage so Starlight never picks light */}
{(
  <script is:inline>
    // Set dark theme immediately, before any other scripts run
    document.documentElement.setAttribute("data-theme", "dark");

    // Prevent Starlight's theme script from overriding
    (function() {
      const originalGetItem = Storage.prototype.getItem;
      Storage.prototype.getItem = function(key) {
        if (key === 'starlight-theme') {
          return 'dark';
        }
        return originalGetItem.call(this, key);
      };
    })();
  </script>
)}

<!-- Include default theme provider -->
<Default />
