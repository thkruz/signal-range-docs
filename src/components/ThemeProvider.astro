---
import Default from '@astrojs/starlight/components/ThemeProvider.astro';

// Server-side check for dark mode parameter
const url = Astro.url;
const forceDark = url.searchParams.get("dark") === "true";
const forceLight = url.searchParams.get("dark") === "false";
---

{forceDark && (
  <!-- Force dark mode when ?dark=true, override localStorage -->
  <script is:inline>
    // Set dark theme immediately, before any other scripts run
    document.documentElement.setAttribute("data-theme", "dark");

    // Prevent Starlight's theme script from overriding
    (function() {
      const originalGetItem = Storage.prototype.getItem;
      Storage.prototype.getItem = function(key) {
        if (key === 'starlight-theme') {
          return 'dark';
        }
        return originalGetItem.call(this, key);
      };
    })();
  </script>
)}

{forceLight && (
  <!-- Force light mode when ?dark=false, override localStorage -->
  <script is:inline>
    // Set light theme immediately
    document.documentElement.setAttribute("data-theme", "light");

    // Prevent Starlight's theme script from overriding
    (function() {
      const originalGetItem = Storage.prototype.getItem;
      Storage.prototype.getItem = function(key) {
        if (key === 'starlight-theme') {
          return 'light';
        }
        return originalGetItem.call(this, key);
      };
    })();
  </script>
)}

<!-- Include default theme provider -->
<Default {...Astro.props} />
